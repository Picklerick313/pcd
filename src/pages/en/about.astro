---
import Layout from "@/layouts/Layout.astro";
import Head from "@/components/Head.astro";
import Title from "@/components/Title.astro";
import { Image, Picture } from "astro:assets";
import me from "/src/assets/img/profile_pic.jpg";
import github from "/src/assets/img/github.svg";
import blur from "/src/assets/img/bg.png";
import { getAbsoluteLocaleUrl } from "astro:i18n";

getAbsoluteLocaleUrl("en");
export const prerender = true;

---

<Head title='About' />
<Layout class="relative">
  <div class="grid mt-[11.1111%] content-center">
    <Title text='About' />
  </div>
  <!-- ABOUT ME -->
  <section class="grid content-start px-3 lg:px-0 mb-[5rem] text-white">
    <Image
      src={blur}
      class="fixed top-0 bottom-0 left-0 right-0 m-auto h-full w-full object-cover object-center z-[-1]"
      alt="blur background"
    />
    <div class="grid grid-flow-col auto-cols-auto content-center mt-20">
      <div class="grid lg:grid-cols-2 blur-bg rounded-xl p-5 lg:py-24 lg:px-16">
        <div class="grid justify-center content-center mb-5 lg:mb-0">
          <Picture
            class="object-cover rounded-full ring-8 ring-white/80 w-full h-full max-w-[200px] max-h-[200px] lg:max-w-[250px] lg:max-h-[250px]"
            src={me}
            formats={["avif", "webp"]}
            width="300"
            height="300"
            alt='Lyu Xingze (Rick)'
          />
        </div>

        <div class="grid justify-center content-center">
          <h6
            class="text-4xl lg:text-5xl font-black bg-clip-text text-transparent bg-gradient-to-r from-primary-0 to-accent-0"
          >
          Lyu Xingze (Louis)
          </h6>
          <p class="text-lg font-medium text-zinc-300 mt-2">MSc Student | Robotics Engineer</p>
          <div class="text-xl font-light text-zinc-200 max-w-xl mt-5">
            <p>
              I am a first-class graduate from Xi'an Jiaotong-Liverpool University, currently pursuing my MSc at the University of Manchester. As a Robotics Engineer and Developer, I specialize in building intelligent robotic systems and developing innovative solutions in the field of robotics.
            </p>
            <p class="mt-5">
              My expertise includes Python, ROS2, SLAM, Robotic arm manipulation, and C++. I am proficient in using mainstream AI tools and passionate about advancing robotics technology. I'm always excited to collaborate on challenging projects that push the boundaries of what's possible in robotics.
            </p>
          </div>
        </div>
      </div>
    </div>
         <!-- SKILLS SECTION -->
    <div class="mt-5">
      <div class="blur-bg rounded-xl p-5 lg:p-10">
        <h2 class="text-5xl font-black text-center bg-clip-text text-transparent bg-gradient-to-r from-primary-0 to-accent-0 mb-8">
          Skills
        </h2>
        <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-4 text-center">
          <div class="blur-bg rounded-xl p-5 hover:bg-primary-0 duration-150">
            <p class="text-lg font-semibold text-white">Python</p>
          </div>
          <div class="blur-bg rounded-xl p-5 hover:bg-primary-0 duration-150">
            <p class="text-lg font-semibold text-white">ROS2</p>
          </div>
          <div class="blur-bg rounded-xl p-5 hover:bg-primary-0 duration-150">
            <p class="text-lg font-semibold text-white">SLAM</p>
          </div>
          <div class="blur-bg rounded-xl p-5 hover:bg-primary-0 duration-150">
            <p class="text-lg font-semibold text-white">Robotic Arm</p>
          </div>
          <div class="blur-bg rounded-xl p-5 hover:bg-primary-0 duration-150">
            <p class="text-lg font-semibold text-white">C++</p>
          </div>
          <div class="blur-bg rounded-xl p-5 hover:bg-primary-0 duration-150">
            <p class="text-lg font-semibold text-white">AI Tools</p>
          </div>
        </div>
      </div>
    </div>

    <!-- CAREER OBJECTIVES -->
    <div class="mt-5">
      <div class="blur-bg rounded-xl p-5 lg:p-10">
        <h2 class="text-5xl font-black text-center bg-clip-text text-transparent bg-gradient-to-r from-primary-0 to-accent-0 mb-5">
          Career Objectives
        </h2>
        <p class="text-2xl font-light text-zinc-200">
          I'm focused on developing intelligent robotic systems that bridge the gap between autonomous navigation and precision manipulation. My research interests include advanced SLAM techniques for dynamic environments, robot perception and sensor fusion, autonomous manipulation systems, and human-robot interaction.
        </p>
        <p class="text-2xl font-light text-zinc-200 mt-5">
          I aim to contribute to innovative robotics solutions that enhance automation capabilities across industrial and service robotics sectors.
        </p>
      </div>
    </div>

    <!-- PROJECTS SECTION -->
    <div class="mt-5">
      <div class="blur-bg rounded-xl p-5 lg:p-10">
        <h2 class="text-5xl font-black text-center bg-clip-text text-transparent bg-gradient-to-r from-primary-0 to-accent-0 mb-8">
          Projects
        </h2>
        
        <!-- Project Grid -->
        <div class="grid lg:grid-cols-2 gap-6">
          <!-- SLAM Robot Project -->
          <div class="blur-bg rounded-xl p-6 hover:bg-white/5 transition-all duration-150">
            <div class="flex justify-between items-start mb-4">
              <h3 class="text-2xl font-bold text-white">SLAM Robot</h3>
              <span class="text-sm font-medium text-zinc-400">2022-2023</span>
            </div>
            <p class="text-lg text-zinc-300 mb-4">
              Simulated SLAM algorithms under ROS2 and validated them with physical robots
            </p>
            <ul class="space-y-2 text-zinc-200">
              <li class="flex items-start">
                <span class="text-primary-0 mr-2">•</span>
                <span>Used OpenCV for visual Hough circle detection to guide grasping</span>
              </li>
              <li class="flex items-start">
                <span class="text-primary-0 mr-2">•</span>
                <span>Guided robot localization and navigation using Apriltag</span>
              </li>
              <li class="flex items-start">
                <span class="text-primary-0 mr-2">•</span>
                <span>Simulated and deployed karto and gmapping algorithms</span>
              </li>
            </ul>
            <div class="mt-4 flex flex-wrap gap-2">
              <span class="px-3 py-1 bg-primary-0/20 text-primary-0 rounded-full text-sm">ROS2</span>
              <span class="px-3 py-1 bg-primary-0/20 text-primary-0 rounded-full text-sm">SLAM</span>
              <span class="px-3 py-1 bg-primary-0/20 text-primary-0 rounded-full text-sm">OpenCV</span>
              <span class="px-3 py-1 bg-primary-0/20 text-primary-0 rounded-full text-sm">Apriltag</span>
            </div>
          </div>
                    <!-- Robot Arm Algorithm Assistant Project -->
                    <div class="blur-bg rounded-xl p-6 hover:bg-white/5 transition-all duration-150">
                      <div class="flex justify-between items-start mb-4">
                        <h3 class="text-2xl font-bold text-white">Robot Arm Algorithm Assistant (Aitrox)</h3>
                        <span class="text-sm font-medium text-zinc-400">2024.9-2025.3</span>
                      </div>
                      <p class="text-lg text-zinc-300 mb-4">
                        Technical research and development for medical robotic arm applications
                      </p>
                      <ul class="space-y-2 text-zinc-200">
                        <li class="flex items-start">
                          <span class="text-primary-0 mr-2">•</span>
                          <span>Conducted technical research and initial development for Realman robotic arm ultrasound thyroid scanning</span>
                        </li>
                        <li class="flex items-start">
                          <span class="text-primary-0 mr-2">•</span>
                          <span>Researched and wrote research plans and patents:</span>
                        </li>
                        <li class="flex items-start ml-4">
                          <span class="text-accent-0 mr-2">◦</span>
                          <span class="italic">Robotic arm assisted by 3D vision for fast ultrasound scanning</span>
                        </li>
                        <li class="flex items-start ml-4">
                          <span class="text-accent-0 mr-2">◦</span>
                          <span class="italic">VLA integration with medical robotic arms to achieve natural language control for liver cancer surgery</span>
                        </li>
                      </ul>
                      <div class="mt-4 flex flex-wrap gap-2">
                        <span class="px-3 py-1 bg-accent-0/20 text-accent-0 rounded-full text-sm">Medical Robotics</span>
                        <span class="px-3 py-1 bg-accent-0/20 text-accent-0 rounded-full text-sm">3D Vision</span>
                        <span class="px-3 py-1 bg-accent-0/20 text-accent-0 rounded-full text-sm">VLA</span>
                        <span class="px-3 py-1 bg-accent-0/20 text-accent-0 rounded-full text-sm">NLP</span>
                      </div>
  
      <!-- Skills Section -->
      <!-- <h3 class="text-2xl font-semibold text-white mt-8 mb-3">Skills</h3>
      <p>
        <strong>Programming Languages:</strong> Python, C++<br/>
        <strong>Robotics Frameworks:</strong> ROS2<br/>
        <strong>Specializations:</strong> SLAM (Simultaneous Localization and Mapping), Robotic Arm Manipulation<br/>
        <strong>Tools & Technologies:</strong> Proficient in mainstream AI tools and applications
      </p> -->
  
      <!-- Career Objectives Section -->
      <!-- <h3 class="text-2xl font-semibold text-white mt-8 mb-3">Career Objectives & Research Interests</h3>
      <p>
        I'm focused on developing intelligent robotic systems that bridge the gap between autonomous navigation and precision manipulation. My research interests include advanced SLAM techniques for dynamic environments, robot perception and sensor fusion, autonomous manipulation systems, and human-robot interaction.
      </p>
      <p class="mt-3">
        I aim to contribute to innovative robotics solutions that enhance automation capabilities across industrial and service robotics sectors.
      </p> -->
    </div>
    </div>
  </div>

</div>

<!-- Second Section: Social Links (SEPARATE WRAPPER) -->
<div class="mt-5">
  <div
