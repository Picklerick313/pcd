  >
    <!-- LEFT COLUMN: Social Links Heading -->
    <div class="grid justify-center content-center mb-5 lg:mb-0">
      <h2
        class="text-5xl font-black text-center bg-clip-text text-transparent bg-gradient-to-r from-primary-0 to-accent-0"
      >
        Social links
      </h2>
    </div>
    
    <!-- RIGHT COLUMN: Social Icons -->
    <div class="grid justify-center content-center">
      <ul class="grid grid-cols-2 gap-5 place-content-center">
        <li>
          <a class="mr-5" href="https://drive.google.com/file/d/1GD49J8TvZKo90e2-0QpPCWU77AhUSTJ5/view?usp=sharing" target="_blank">
            <div
